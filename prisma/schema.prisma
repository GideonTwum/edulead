generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
}

enum ProgrammeStatus {
  PLANNED
  COMING_SOON
  OPEN
  ONGOING
  COMPLETED
  ARCHIVED
}

enum ProgrammeCategory {
  MENTORSHIP_COACHING
  POLICY_LEADERSHIP_TRAINING
  CAREER_DEVELOPMENT
  YOUTH_POLICY_DIALOGUE
  CIVIC_LEADERSHIP
  COMMUNICATION_RESEARCH
}

enum OpportunityType {
  SCHOLARSHIP
  FELLOWSHIP
  INTERNSHIP
  JOB
  CONFERENCE
  COMPETITION
  GRANT
  TRAINING
  EXCHANGE_PROGRAMME
  VOLUNTEER_OPPORTUNITY
}

enum LocationType {
  ON_SITE
  REMOTE
  HYBRID
  INTERNATIONAL
}

enum OpportunityStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventType {
  WORKSHOP
  WEBINAR
  POLICY_DIALOGUE
  SEMINAR
  CONFERENCE
  NETWORKING_SESSION
  MENTORSHIP_SESSION
  TRAINING
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum JoinType {
  YOUNG_PERSON
  MENTOR
  VOLUNTEER
  PARTNER
  SUPPORTER
}

enum SubmissionStatus {
  NEW
  REVIEWED
  CONTACTED
  CLOSED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum MediaType {
  IMAGE
  PDF
  DOCUMENT
  OTHER
}

enum PageKey {
  HOME
  ABOUT
  JOIN
  CONTACT
  FOOTER
  NAVIGATION
  ANNOUNCEMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGOUT
}

model AdminProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  email     String    @unique
  fullName  String?
  role      AdminRole @default(ADMIN)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  auditLogs AuditLog[]
}

model SiteSetting {
  id                    String   @id @default(cuid())
  organisationName      String   @default("EduLead Network")
  tagline               String   @default("Education for Leadership and Change")
  logoUrl               String?
  faviconUrl            String?
  generalEmail          String?
  phone                 String?
  whatsapp              String?
  address               String?
  facebookUrl           String?
  twitterUrl            String?
  instagramUrl          String?
  linkedinUrl           String?
  youtubeUrl            String?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  googleAnalyticsId     String?
  contactNotifyEmail    String?
  joinNotifyEmail       String?
  newsletterFromName    String   @default("EduLead Network")
  maintenanceMode       Boolean  @default(false)
  footerText            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PageContent {
  id          String   @id @default(cuid())
  pageKey     PageKey
  sectionKey  String
  heading     String?
  subheading  String?
  body        String?  @db.Text
  imageUrl    String?
  buttonLabel String?
  buttonUrl   String?
  metadata    Json?
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  draftData   Json?
  requiresConfirmation Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pageKey, sectionKey])
  @@index([pageKey, published])
}

model Programme {
  id                    String            @id @default(cuid())
  title                 String
  slug                  String            @unique
  excerpt               String            @db.Text
  description           String            @db.Text
  featuredImage         String?
  galleryImages         String[]          @default([])
  category              ProgrammeCategory
  format                String?
  targetAudience        String?
  location              String?
  startDate             DateTime?
  endDate               DateTime?
  applicationDeadline   DateTime?
  externalApplicationUrl String?
  contactEmail          String?
  interestFormEnabled   Boolean           @default(true)
  status                ProgrammeStatus   @default(PLANNED)
  featured              Boolean           @default(false)
  published             Boolean           @default(false)
  objectives            String?           @db.Text
  expectations          String?           @db.Text
  whoIsItFor            String?           @db.Text
  timeline              String?           @db.Text
  seoTitle              String?
  seoDescription        String?
  deletedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  interests             ProgrammeInterest[]

  @@index([slug])
  @@index([status, published])
  @@index([featured, published])
}

model ProgrammeInterest {
  id           String   @id @default(cuid())
  programmeId  String
  programme    Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String?
  country      String
  institution  String?
  motivation   String?  @db.Text
  consent      Boolean  @default(true)
  status       SubmissionStatus @default(NEW)
  internalNote String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([programmeId])
  @@index([status])
}

model Opportunity {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  organisation    String
  excerpt         String            @db.Text
  description     String            @db.Text
  opportunityType OpportunityType
  country         String?
  locationType    LocationType
  eligibility     String?           @db.Text
  deadline        DateTime?
  applicationUrl  String?
  featuredImage   String?
  tags            String[]          @default([])
  featured        Boolean           @default(false)
  published       Boolean           @default(false)
  status          OpportunityStatus @default(ACTIVE)
  seoTitle        String?
  seoDescription  String?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([slug])
  @@index([status, published])
  @@index([deadline])
  @@index([opportunityType])
}

model Event {
  id                     String   @id @default(cuid())
  title                  String
  slug                   String   @unique
  excerpt                String   @db.Text
  description            String   @db.Text
  featuredImage          String?
  eventType              EventType
  date                   DateTime
  endDate                DateTime?
  startTime              String?
  endTime                String?
  timezone               String   @default("Africa/Accra")
  venue                  String?
  onlineLink             String?
  registrationUrl        String?
  registrationFormEnabled Boolean @default(false)
  registrationDeadline   DateTime?
  capacity               Int?
  featured               Boolean  @default(false)
  status                 EventStatus @default(UPCOMING)
  published              Boolean  @default(false)
  seoTitle               String?
  seoDescription         String?
  deletedAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  registrations          EventRegistration[]

  @@index([slug])
  @@index([status, published])
  @@index([date])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String?
  institution  String?
  country      String?
  reason       String?  @db.Text
  consent      Boolean  @default(true)
  status       SubmissionStatus @default(NEW)
  internalNote String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
  @@index([email])
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  excerpt         String         @db.Text
  content         String         @db.Text
  featuredImage   String?
  authorName      String?
  authorImage     String?
  categoryId      String?
  category        ArticleCategory? @relation(fields: [categoryId], references: [id])
  categoryLabel   String?
  tags            String[]       @default([])
  readingTime     Int?
  downloadableFile String?
  seoTitle        String?
  seoDescription  String?
  featured        Boolean        @default(false)
  status          ArticleStatus  @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([featured])
}

model TeamMember {
  id            String   @id @default(cuid())
  fullName      String
  role          String
  biography     String   @db.Text
  profileImage  String?
  linkedinUrl   String?
  email         String?
  showEmail     Boolean  @default(false)
  displayOrder  Int      @default(0)
  active        Boolean  @default(true)
  requiresConfirmation Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, displayOrder])
}

model JoinSubmission {
  id              String           @id @default(cuid())
  joinType        JoinType
  fullName        String
  email           String
  phone           String?
  country         String?
  formData        Json
  attachmentUrl   String?
  status          SubmissionStatus @default(NEW)
  internalNote    String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([joinType, status])
  @@index([email])
}

model ContactMessage {
  id           String        @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  subject      String
  enquiryType  String
  message      String        @db.Text
  consent      Boolean       @default(true)
  status       ContactStatus @default(NEW)
  internalNote String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([email])
}

model NewsletterSubscriber {
  id             String   @id @default(cuid())
  firstName      String
  email          String   @unique
  consent        Boolean  @default(true)
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

model MediaAsset {
  id          String    @id @default(cuid())
  fileName    String
  originalName String
  url         String
  bucket      String
  folder      String
  mediaType   MediaType
  mimeType    String
  size        Int
  altText     String?
  isPublic    Boolean   @default(true)
  usedIn      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([folder, mediaType])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  adminId    String?
  admin      AdminProfile? @relation(fields: [adminId], references: [id])
  action     AuditAction
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
